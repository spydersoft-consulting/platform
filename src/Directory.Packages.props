<Project>
	<PropertyGroup>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
	</PropertyGroup>

	<ItemGroup>
		<!-- Microsoft Packages -->
		<PackageVersion Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.15" />
		<PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.Abstractions" Version="10.0.15" />
		<PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.34" Condition="'$(TargetFramework)' == 'net8.0'" />
		<PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="9.0.23" Condition="'$(TargetFramework)' == 'net9.0'" />
		<PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" Condition="'$(TargetFramework)' == 'net10.0'" />

		<!-- Microsoft.AspNetCore.Authentication.JwtBearer - Framework Specific -->
		<PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.34" Condition="'$(TargetFramework)' == 'net8.0'" />
		<PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.23" Condition="'$(TargetFramework)' == 'net9.0'" />
		<PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" Condition="'$(TargetFramework)' == 'net10.0'" />

		<!-- OpenTelemetry Packages -->
		<PackageVersion Include="OpenTelemetry.Exporter.Console" Version="1.21.0" />
		<PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
		<PackageVersion Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.15.3-beta.1" />
<PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
		<PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0" />
		<PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.21.0" />
		<PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.21.0" />

		<!-- Serilog -->
		<PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />

		<!-- FusionCache -->
		<PackageVersion Include="ZiggyCreatures.FusionCache" Version="2.9.0" />
		<PackageVersion Include="ZiggyCreatures.FusionCache.Backplane.StackExchangeRedis" Version="2.9.0" />
		<PackageVersion Include="ZiggyCreatures.FusionCache.OpenTelemetry" Version="2.9.0" />
		<PackageVersion Include="ZiggyCreatures.FusionCache.Serialization.SystemTextJson" Version="2.9.0" />

		<!-- Resilience -->
		<PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />

		<!-- Messaging -->
		<PackageVersion Include="RabbitMQ.Client" Version="7.2.2" />
		<PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.15" />
		<PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.15" />
		<PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.15" />
		<PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
		<PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.15" />
		<PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15" />
		<PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.15" />

		<!-- Third Party -->
		<PackageVersion Include="NeoSmart.Caching.Sqlite.AspNetCore" Version="9.0.3" />

		<!-- Test Packages -->
		<PackageVersion Include="coverlet.collector" Version="10.1.1" />
		<PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
		<PackageVersion Include="NUnit" Version="4.6.1" />
		<PackageVersion Include="NUnit.Analyzers" Version="4.15.0" />
		<PackageVersion Include="NUnit3TestAdapter" Version="6.3.1" />
		<PackageVersion Include="Testcontainers.RabbitMq" Version="4.17.0" />
	</ItemGroup>
</Project>
